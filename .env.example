EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent
# Khi model chính báo quá tải (503), app gọi model này.
EXPO_PUBLIC_GEMINI_BACKUP_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash:generateContent

# Supabase Connect > App Frameworks. Publishable key được phép nằm trong app khi RLS đã bật.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google không đọc client id từ app. Bật provider Google trên Supabase và dán Web Client ID + Secret ở đó.
# Google Cloud (OAuth client loại Web) → Authorized redirect URIs:
#   https://<project-ref>.supabase.co/auth/v1/callback
# Supabase → Authentication → URL Configuration:
# Site URL đang là http://localhost:3000 thì Safari trên điện thoại báo không kết nối được máy chủ.
# Redirect URLs cần có:
#   exp://**
#   tikimoney://**
